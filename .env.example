# Environment Configuration for AI Engineering RAG

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501

# LLM Provider Configuration
# Supported providers: openai, gemini, anthropic, ollama, custom
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_google_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Embedding Model Configuration
# Options: local_fast (TF-IDF/Hashing or MiniLM fallback), bge_m3, text-embedding-3-small, custom
EMBEDDING_PROVIDER=local_fast
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Store (Qdrant)
# Use ':memory:' for memory mode, or path like './storage/qdrant' for persistent local mode
QDRANT_STORAGE_PATH=./storage/qdrant
QDRANT_COLLECTION=ai_engineering_book

# Reranker Configuration
# Options: cross_encoder, lexical_dense_hybrid, rrf_weighted
RERANKER_TYPE=cross_encoder

# Retrieval Hyperparameters
TOP_K_DENSE=30
TOP_K_BM25=30
RRF_K=60
FINAL_TOP_K=6
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# Data Paths
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
PROCESSED_DIR=./data/processed
EVALUATION_DIR=./data/evaluation
